# =============================
# PRODUCTION SETTINGS (DROPLET)
# =============================
# Every setting the server needs. Make your own copy with real values (keep
# it out of git, e.g. .env.production on your Mac), then put it on the server
# as .env next to docker-compose.yml. See docs/deploy.md.

# ======
# DOMAIN
# ======
# The subdomain Caddy gets an HTTPS certificate for (its DNS A record must
# point at the droplet's reserved IP before the first start).
DOMAIN=bot.zazoai.com
# What Twilio calls and signs webhooks against: https:// + DOMAIN, no trailing slash.
PUBLIC_BASE_URL=https://bot.zazoai.com

# ===
# APP
# ===
APP_ENV=production
BOT_LANGUAGE=en
# Shown in the HELP message: a phone number or email for the project team.
SUPPORT_CONTACT=

# ======
# TWILIO
# ======
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sender number in E.164, e.g. +14155238886 for the sandbox.
TWILIO_WHATSAPP_NUMBER=
# Keep true in production: rejects webhooks not signed by Twilio.
TWILIO_VALIDATE_SIGNATURE=true
# true: delete media from Twilio once stored (and media from unregistered
# senders, without downloading it). Can't be undone.
TWILIO_DELETE_MEDIA=true

# =====
# MEDIA
# =====
# Signs the image URLs Twilio fetches. Use a new value on the server, not your
# laptop's:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_SIGNING_SECRET=

# ========
# POSTGRES
# ========
# Used to create the database in the postgres container on first start, and
# by the app to connect. Choose a long random password.
POSTGRES_USER=speech
POSTGRES_PASSWORD=
POSTGRES_DB=speech_collector
# Set by docker-compose.yml inside the containers; no need to set them here:
#   POSTGRES_HOST=postgres, POSTGRES_PORT=5432, REDIS_URL=redis://redis:6379/0,
#   AUDIO_ROOT=/app/data/audio, PROMPT_MEDIA_ROOT=/app/data/prompts/images/_prepared

# ==============
# CONTAINER USER
# ==============
# The app runs as this user ID inside the containers; it must own ./data on the
# server. 1000 is the first user on Ubuntu (check with: id -u).
APP_UID=1000
