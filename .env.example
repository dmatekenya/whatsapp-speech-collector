APP_ENV=development
# Deployment only (docker-compose.yml / Caddy): the HTTPS domain, e.g. speech.example.org
DOMAIN=
BOT_LANGUAGE=en
SUPPORT_CONTACT=
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_DELETE_MEDIA=false

# Meta WhatsApp Cloud API (all optional; Twilio-only setups can leave them empty).
# Webhook: https://<your domain>/webhooks/meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v23.0
# Replies always go out on the channel the participant wrote to; this is only
# the default for messages that answer nothing (e.g. scripts/send_test_image.py).
WHATSAPP_PROVIDER=twilio

POSTGRES_USER=speech
POSTGRES_PASSWORD=
POSTGRES_DB=speech_collector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Relative paths are resolved against the project root.
AUDIO_ROOT=data/audio
PROMPT_MEDIA_ROOT=data/prompts/images/_prepared
# Signs media URLs sent to Twilio. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_SIGNING_SECRET=

# ASR batch (scripts/asr_batch.sh): a Modal API token. Optional on a laptop that
# has run `modal setup` (it uses ~/.modal.toml); needed on the droplet.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
